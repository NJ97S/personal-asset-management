# Database (libsql / Turso). Local dev uses ./local.db automatically.
DATABASE_URL=file:./local.db
# DATABASE_AUTH_TOKEN=  # only needed when DATABASE_URL is libsql://... or https://...

# Auth.js v5 — REQUIRED IN PRODUCTION.
# Generate with: openssl rand -base64 32
# In dev a hard-coded fallback is used so you can boot without setting this.
AUTH_SECRET=

# Seed script (npm run db:seed) reads these to create the default user.
SEED_EMAIL=me@asset.local
SEED_PASSWORD=asset-dev-1234
